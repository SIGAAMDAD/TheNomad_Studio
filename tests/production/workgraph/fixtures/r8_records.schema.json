{
  "$defs": {
    "ArtifactManifest": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "SOURCE",
                  "SCENE"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_parent_commit"
            ]
          }
        }
      ],
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "bible_pair_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "byte_proof_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "feature_contract_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "feature_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "SOURCE",
            "ASSET",
            "SCENE",
            "QUEST_GRAPH",
            "DIALOGUE",
            "AUDIO",
            "TEST_LOG",
            "OTHER"
          ],
          "type": "string"
        },
        "producer_principal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "resource_path": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "source_parent_commit": {
          "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "feature_id",
        "task_id",
        "kind",
        "resource_path",
        "content_sha256",
        "producer_principal",
        "bible_pair_digest",
        "feature_contract_digest",
        "byte_proof_ref"
      ],
      "type": "object"
    },
