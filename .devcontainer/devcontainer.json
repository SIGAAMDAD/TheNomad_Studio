{
  "name": "Nomad Studio R5R optional development environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/dotnet:2": {"version": "10.0"}
  },
  "postCreateCommand": "python -m pip install -e '.[coordinator,dev]' && cd ui && npm ci --ignore-scripts --no-audit --no-fund",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-dotnettools.csharp", "dbaeumer.vscode-eslint"]}},
  "hostRequirements": {"cpus": 2, "memory": "4gb"},
  "remoteUser": "vscode"
}
