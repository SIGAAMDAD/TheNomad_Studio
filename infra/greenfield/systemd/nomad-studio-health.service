[Unit]
Description=Nomad Studio R9 readiness preflight
After=nomad-studio.service

[Service]
Type=oneshot
User=nomad-studio
Group=nomad-studio
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/nomad-studio/current/venv/bin/python -m nomad_studio.app --doctor --config /etc/nomad-studio/r9-runtime.json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/nomad-studio
