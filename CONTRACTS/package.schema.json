{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nomad package manifest (without self-digest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "package_version",
    "kind",
    "capabilities",
    "dependencies",
    "entrypoints",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "engine",
        "discipline",
        "genre",
        "toolchain",
        "template",
        "tool",
        "other"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executable_digest",
          "args_schema_digest",
          "output_schema_digest",
          "required_isolation",
          "executable_path",
          "args_schema_path",
          "output_schema_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "executable_digest": {
            "type": "string",
            "minLength": 1
          },
          "args_schema_digest": {
            "type": "string",
            "minLength": 1
          },
          "output_schema_digest": {
            "type": "string",
            "minLength": 1
          },
          "required_isolation": {
            "type": "string",
            "minLength": 1
          },
          "executable_path": {
            "type": "string",
            "minLength": 1
          },
          "args_schema_path": {
            "type": "string",
            "minLength": 1
          },
          "output_schema_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license_id": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
