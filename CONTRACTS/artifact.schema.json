{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nomad artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "artifact_id",
    "kind",
    "content_digest",
    "manifest_digest",
    "producer_session_id",
    "source_revision_id",
    "canon_snapshot_id",
    "validator_digest",
    "storage_key"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "minLength": 1
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    },
    "producer_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canon_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "validator_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "storage_key": {
      "type": "string",
      "minLength": 1
    }
  }
}
