# Sample names only. Copy into an untracked secure deployment environment.
# Do not commit real credentials, owner proofs or access tokens.
STUDIO_COMPOSITION_FACTORY=studio.app.production_factory:build_from_environment
# Required: installed trusted Python module:function that returns TrustedPorts.
STUDIO_TRUSTED_PORTS_FACTORY=
# Required persistent paths (mount these inside the container if using Compose).
STUDIO_APSW_DATABASE=/var/lib/nomad-studio/studio.sqlite3
STUDIO_BLOB_ROOT=/var/lib/nomad-studio/blobs
STUDIO_SOURCE_ROOT=/var/lib/nomad-studio/sources
STUDIO_CONTRACT_DIR=CONTRACTS
# Operator transport is loopback only; TLS ingress must be separately deployed.
STUDIO_OPERATOR_HOST=127.0.0.1
STUDIO_OPERATOR_PORT=8000
# No AI model API worker key or scheduled browser worker service is configured.
