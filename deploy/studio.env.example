# R5 has no AI model API keys and never automatically starts browser ChatGPT workers.
STUDIO_DATA_ROOT=/var/lib/nomad-studio
STUDIO_GITHUB_REPO=
STUDIO_GITHUB_REF=
STUDIO_GITHUB_RELAY_PREFIX=
STUDIO_DEPLOYMENT_MODE=manual-browser-github-relay
# Credentials are supplied to configured WG-G connector out of band, not in this file.
# Must be an authenticated, actual A-L assembly factory returning MComposition.
STUDIO_COMPOSITION_FACTORY=
