{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio derived worker inbox V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "job_id",
    "assignment_epoch",
    "registered_status",
    "identity_assurance",
    "authoritative",
    "source",
    "pending",
    "acknowledged",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "worker_id": {
      "type": "string",
      "pattern": "^CW-[A-Z0-9-]+$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "registered_status": {
      "enum": [
        "ASSIGNED",
        "PAUSED",
        "RETIRED"
      ]
    },
    "identity_assurance": {
      "const": "SHARED_OWNER_CONNECTOR_NOT_INDEPENDENTLY_AUTHENTICATED"
    },
    "authoritative": {
      "const": false
    },
    "source": {
      "type": "string"
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "acknowledged": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "job_id",
          "source_job_id",
          "sender_worker_id",
          "event_type",
          "timestamp_utc",
          "summary",
          "requires_ack",
          "ack_event_id",
          "source_verification",
          "delivery_authority"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^evt-[0-9a-f]{32}$"
          },
          "job_id": {
            "type": "string"
          },
          "source_job_id": {
            "type": "string"
          },
          "sender_worker_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          },
          "requires_ack": {
            "type": "boolean"
          },
          "ack_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "object",
              "null"
            ]
          },
          "source_verification": {
            "type": "string"
          },
          "delivery_authority": {
            "const": "ARCHIVE_ONLY"
          }
        }
      }
    }
  }
}
