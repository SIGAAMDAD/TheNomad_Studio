{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio V1 broker-normalized immutable event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "recorded_at_utc",
    "event_type",
    "job_id",
    "worker_id",
    "identity_assurance",
    "delivery_authority",
    "transport",
    "recipient",
    "summary",
    "requested_action",
    "requires_ack",
    "source_verification",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[a-f0-9]{32}$"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "STATUS",
        "CHECKPOINT",
        "DEPENDENCY_REQUEST",
        "DEPENDENCY_RESOLVED",
        "HANDOFF_READY",
        "QA_REQUEST",
        "QA_RESULT",
        "CI_RESULT",
        "BLOCKED",
        "ACK"
      ]
    },
    "job_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "assignment_epoch": {
      "type": [
        "integer",
        "null"
      ]
    },
    "role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_assurance": {
      "const": "UNVERIFIED_SHARED_OWNER"
    },
    "delivery_authority": {
      "const": "ARCHIVE_ONLY"
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "department_id",
        "job_id"
      ],
      "properties": {
        "department_id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "issue_number",
        "comment_id",
        "actor_login"
      ],
      "properties": {
        "repo": {
          "const": "SIGAAMDAD/TheNomad_Studio"
        },
        "issue_number": {
          "type": "integer"
        },
        "comment_id": {
          "type": "integer"
        },
        "actor_login": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "requested_action": {
      "type": "string"
    },
    "requires_ack": {
      "type": "boolean"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_verification": {
      "const": "NOT_RUN"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
