{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-authorized shift control envelope (proposed, not installed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shift_id",
    "shift_epoch",
    "command",
    "issued_at_utc",
    "owner_approval_ref",
    "scope",
    "limits",
    "issuer_signature_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "shift_id": {
      "type": "string",
      "pattern": "^SHIFT-[A-Za-z0-9_-]{10,80}$"
    },
    "shift_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "command": {
      "enum": [
        "START",
        "PAUSE",
        "RESUME",
        "DRAIN",
        "STOP"
      ]
    },
    "issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "owner_approval_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    },
    "issuer_signature_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "departments",
        "job_ids"
      ],
      "properties": {
        "departments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{3,30}$"
          },
          "uniqueItems": true
        },
        "job_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "allow_newly_approved_jobs": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_active_attempts",
        "max_retries_per_job",
        "max_wall_hours",
        "budget_currency_minor_units"
      ],
      "properties": {
        "max_active_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_retries_per_job": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_wall_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "budget_currency_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "max_per_department": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "max_per_repo_source_writers": {
          "type": "integer",
          "minimum": 0
        },
        "stop_after_queue_drain": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
