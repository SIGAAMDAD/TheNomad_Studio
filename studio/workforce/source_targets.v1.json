{
  "schema_version": 1,
  "policy": "studio_control_plane_only",
  "control_repository": "SIGAAMDAD/TheNomad_Studio",
  "source_authority": "studio/runtime/studio/config.json + approved source registry + per-job pinned SHA",
  "source_routes": [
    {
      "component": "terrain3d",
      "repository": "SIGAAMDAD/Terrain3D",
      "target_branch": "Terrain3D_NomadRenderer",
      "verified_branch_head_at_intake": "1e00735913a3cfa5d0e73bd7817c37d5b0b2c9db",
      "status": "SOURCE_FREEZE_REQUIRED",
      "ownership": "Rendering engine programmers: Terrain3D renderer, rendering integrations, HLOD, VT, foliage and visual rendering work",
      "target_url": "https://github.com/SIGAAMDAD/Terrain3D/tree/Terrain3D_NomadRenderer",
      "workstream": "rendering_engine",
      "language_policy": "Per approved rendering job"
    },
    {
      "component": "nomad_framework",
      "repository": "SIGAAMDAD/NomadFramework",
      "target_branch": "develop",
      "verified_branch_head_at_intake": "8617caecbaf4571917eac2cd2aeee459485740fc",
      "status": "SOURCE_FREEZE_REQUIRED",
      "ownership": "Reusable framework engine programmers, native framework and GDExtension; develop is canonical development branch",
      "target_url": "https://github.com/SIGAAMDAD/NomadFramework/tree/develop",
      "workstream": "framework_engine",
      "language_policy": "Per approved framework job",
      "development_primary_branch": true
    },
    {
      "component": "nomad_game",
      "repository": "SIGAAMDAD/The_Nomad",
      "target_branch": "Nomad3D",
      "verified_branch_head_at_intake": "b92cc734a542964c19e01cde792c62ef3538e150",
      "status": "SOURCE_FREEZE_REQUIRED",
      "ownership": "Core gameplay programmers implementing non-mod-dependent game systems",
      "target_url": "https://github.com/SIGAAMDAD/The_Nomad/tree/Nomad3D",
      "workstream": "core_gameplay",
      "language_policy": "Per approved core gameplay job"
    },
    {
      "component": "nomad_mod",
      "workstream": "mod_gameplay",
      "repository": "SIGAAMDAD/NomadMain",
      "target_branch": "main",
      "verified_branch_head_at_intake": "efa9840fb204cb0609869165dec6b17972dedacc",
      "status": "SOURCE_FREEZE_REQUIRED",
      "ownership": "Mod-dependent gameplay implementation and mod-specific behaviors in C#",
      "language_policy": "C#",
      "required_language": "C#",
      "target_url": "https://github.com/SIGAAMDAD/NomadMain/tree/main"
    },
    {
      "component": "goap_core",
      "repository": "SIGAAMDAD/TheNomad_GOAP",
      "target_branch": "main",
      "verified_branch_head_at_intake": "258a2623aa5de9d422be02c59855861570ede4ac",
      "status": "SOURCE_FREEZE_REQUIRED",
      "ownership": "Standalone GOAP planning runtime/compiler, schemas, C++17 and C# interop contracts",
      "target_url": "https://github.com/SIGAAMDAD/TheNomad_GOAP",
      "workstream": "goap_core",
      "language_policy": "C++17 native and C# managed contracts (per job)",
      "reference_sources": {
        "fear_sdk_submodule": "xfw5/Fear-SDK-1.08@2fc3557b0037d5fe01ac607b907d4b8511b9e4b2",
        "eastl": "e323f67e5d93fdadcd44f7998069d804697b1945",
        "eabase": "0699a15efdfd20b6cecf02153bfa5663decb653c",
        "cross_platform_ci": "https://github.com/SIGAAMDAD/TheNomad_GOAP/actions/runs/40474509032"
      }
    }
  ],
  "branch_contract": {
    "job_work_branch": "studio/<JOB_ID>",
    "source_work_branch_is_created_in": "same_source_repository",
    "pr_head_repository": "same_as_source_repository",
    "pr_base_repository": "same_as_source_repository",
    "pr_base_branch": "source_routes[component].target_branch",
    "write_strategy": "commit_and_push_only_to_job_work_branch",
    "owner_merge_only": true,
    "no_fallback_to_default_branch": true,
    "no_fork_source_writes": true,
    "no_cross_repository_cherry_pick_without_owner_gate": true
  },
  "safeguards": {
    "source_jobs_must_not_target_control_repo": true,
    "control_repo_allowed_content": [
      "studio scripts and workflows",
      "work manifests, issue intake, receipts, QA reports",
      "role policies and production documentation"
    ],
    "control_repo_forbidden_content": [
      "GOAP runtime and compiler sources",
      "NomadFramework game-engine or GDExtension source",
      "The_Nomad gameplay source",
      "Terrain3D renderer and plugin source",
      "NomadMain mod-specific C# gameplay source"
    ],
    "require_authorized_runtime_allowlist": true,
    "require_verified_remote_branch_head_at_job_creation": true,
    "require_job_pinned_baseline_sha": true,
    "require_source_frozen_before_coding": true,
    "require_exclusive_work_branch_claim": true,
    "require_matching_final_commit_and_drive_receipt": true,
    "retain_source_writes_disabled_by_default": true,
    "retain_auto_ai_disabled_by_default": true,
    "require_explicit_owner_approved_workstream": true,
    "enforce_mod_specific_csharp": true
  },
  "integration_order": [
    "SIGAAMDAD/TheNomad_GOAP:main",
    "SIGAAMDAD/NomadFramework:develop",
    "SIGAAMDAD/The_Nomad:Nomad3D",
    "SIGAAMDAD/NomadMain:main (mod-specific C# gameplay where applicable)"
  ],
  "notes": "All routes are owner-selected workstream targets. Inspected SHAs are historical references, not automatically frozen baselines. TheNomad_Studio is control only. No implicit dependency exists between every pair; the Director creates an explicit DAG for each feature. Work credits, source writes and native event triggers remain disabled.",
  "routing_rule": "Use explicit owner-approved job workstream to choose repo; never infer mod/core ownership from worker role name or language alone.",
  "workstream_contract": {
    "rendering_engine": "SIGAAMDAD/Terrain3D:Terrain3D_NomadRenderer",
    "framework_engine": "SIGAAMDAD/NomadFramework:develop",
    "core_gameplay": "SIGAAMDAD/The_Nomad:Nomad3D",
    "mod_gameplay": "SIGAAMDAD/NomadMain:main (C#)",
    "goap_core": "SIGAAMDAD/TheNomad_GOAP:main"
  }
}
